.githooks/pre-push text eol=lf
# Protocol fixtures include intentionally invalid UTF-8 and exact byte boundaries.
tests/fixtures/protocol-v0/*.json -text
tests/fixtures/protocol-v0/*.txt text eol=lf
# This rejection fixture is deliberately 65,537 spaces, not formatted JSON.
tests/fixtures/protocol-v0/oversized.json -whitespace
# Preserve the pinned upstream SDK bytes and their checksum manifest on Windows.
native/telemetry-plugin/vendor/scs-sdk-1.15/** -text
# Protocol v1 fixtures also include intentionally invalid UTF-8 and exact byte boundaries.
tests/fixtures/protocol-v1/*.json -text
tests/fixtures/protocol-v1/*.txt text eol=lf
# Minor-1 fixtures (ET-050b) live in their own directory, so the minor-0 manifest and its readers stay unchanged.
tests/fixtures/protocol-v1/minor1/*.json -text
tests/fixtures/protocol-v1/minor1/*.txt text eol=lf
# Minor-2 fixtures (ET-052) live in their own directory, so the minor-0 and minor-1 manifests and their readers stay unchanged.
tests/fixtures/protocol-v1/minor2/*.json -text
tests/fixtures/protocol-v1/minor2/*.txt text eol=lf
# These size fixtures are valid JSON padded with trailing spaces to an exact byte length.
tests/fixtures/protocol-v1/checkpoint-size-limit.json -whitespace
tests/fixtures/protocol-v1/checkpoint-oversized.json -whitespace
tests/fixtures/protocol-v1/event-size-limit.json -whitespace
tests/fixtures/protocol-v1/event-oversized.json -whitespace
tests/fixtures/protocol-v1/hello-exact.json -whitespace
tests/fixtures/protocol-v1/hello-oversized.json -whitespace
# Protocol v1 simulator scenarios and hand-written expectations keep their exact bytes (ET-005b).
tests/fixtures/simulator-v1/**/*.json -text
tests/fixtures/simulator-v1/*.txt text eol=lf

# Storage fixtures are immutable historical databases checked by SHA-256 (tests/fixtures/storage/manifest.txt).
tests/fixtures/storage/*.sqlite binary
tests/fixtures/storage/*.sql text eol=lf
tests/fixtures/storage/*.json text eol=lf
tests/fixtures/storage/manifest.txt text eol=lf

# Preserve the unchanged upstream M PLUS Rounded 1c copyright/OFL bytes in Windows checkouts.
apps/desktop/src/assets/m-plus-rounded-1c-OFL.txt -text
