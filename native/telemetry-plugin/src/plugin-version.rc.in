// Version resource of the game plugin DLL (ET-055). CMake configures one copy per build channel; OriginalFilename lets a
// reader tell a renamed production DLL from a staging one. The plugin carries no product version of its own: the
// application's plugin bundle manifest records the application version (docs/plugin-setup.md#bundle-format).
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@PLUGIN_PRODUCT@ game plugin"
      VALUE "InternalName", "@PLUGIN_NAME@"
      VALUE "OriginalFilename", "@PLUGIN_NAME@.dll"
      VALUE "ProductName", "@PLUGIN_PRODUCT@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
