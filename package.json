{
  "name": "ets2telemetry-desktop",
  "productName": "ETS2Telemetry Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local ETS2 and ATS telemetry desktop scaffold",
  "author": "Artur Sianiuk",
  "license": "MIT",
  "main": "apps/desktop/dist/main.cjs",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*",
    "tools/telemetry-simulator"
  ],
  "scripts": {
    "dev": "npm run build && electron-forge start",
    "build": "node scripts/build-native-client.mjs && node scripts/stage-native-plugin.mjs && node scripts/build.mjs && npm run build --workspace @ets2telemetry/telemetry-simulator",
    "typecheck": "tsc --noEmit",
    "lint:install": "npm ci --prefix tools/lint",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js --max-warnings 0 .",
    "lint:ps": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/Invoke-ScriptAnalysis.ps1",
    "test": "vitest run",
    "test:cap0-chain": "vitest run --config vitest.cap0-chain.config.mts",
    "test:v1-chain": "vitest run --config vitest.v1-chain.config.mts",
    "test:plugin-lock": "vitest run --config vitest.plugin-lock.config.mts",
    "test:storage": "node scripts/build-storage-test-bundles.mjs node_modules/vitest/vitest.mjs run --config vitest.storage.config.mts",
    "measure:storage": "node scripts/run-electron-node.mjs node_modules/vitest/vitest.mjs run --config vitest.storage-measure.config.mts",
    "test:electron": "npm run package && playwright test",
    "inspect:package": "node scripts/inspect-package.mjs",
    "postinstall": "install-electron",
    "package": "npm run build && electron-forge package --platform win32 --arch x64",
    "make": "npm run build && electron-forge make --platform win32 --arch x64",
    "native:configure": "node scripts/configure-native-plugin.mjs",
    "native:build": "cmake --build native/telemetry-plugin/build --config Release --parallel",
    "native:test": "ctest --test-dir native/telemetry-plugin/build -C Release --output-on-failure",
    "capture:export": "node tools/capture-export/build.mjs && node tools/capture-export/dist/cli.cjs",
    "channel:probe": "node tools/channel-probe/build.mjs && node tools/channel-probe/dist/cli.cjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron/asar": "4.3.1",
    "@fontsource/huninn": "5.3.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "electron": "44.7.0",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "better-sqlite3@13.0.3": false
  }
}
