{
  "format": "ets2telemetry.deferred-cleanup-cases",
  "version": 1,
  "about": "ET-018 PR-5: one table, two implementations. tests/unit/uninstall-deferred-cases.test.ts runs the TypeScript engine (apps/desktop/src/uninstall/) and tests/windows/Test-DeferredCleanup.ps1 runs the deferred-cleanup executor (resources/uninstall/Complete-ETS2TelemetryUninstall.ps1) on the same scene. Each scene is a later run after a deferred uninstall: the data root holds data, settings and logs, the install registry plugins/setup.json with one install record for the folder (sha256 of 'owned', createdPluginsDirectory from 'created'), and the intent uninstall/pending.json (attempts 1) naming the folder with the hash of 'owned', its temporary file when 'temp' is set, and the hash of 'known' in known. Both must agree on the outcome, the code and what is kept or removed. ET-055: the executor's run plays the table in both build channels, each with its own names; folder.otherChannel adds the other channel's plugin file with the 'owned' bytes, which this channel never removes; data.updatesEntry adds an interrupted in-app update download in the allowlisted updates folder. See docs/uninstall.md, 'Deferred cleanup at the next sign-in'.",
  "contents": {
    "owned": "ETS2Telemetry deferred-cleanup case: the plugin file this application installed.\n",
    "known": "ETS2Telemetry deferred-cleanup case: a released plugin file of this application.\n",
    "foreign": "Another tool's file that happens to carry the plugin's name.\n"
  },
  "cases": [
    {"id": "owned-removed", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "known-hash-removed", "folder": {"game": "ats", "layout": "game", "dll": "known"}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "unrecognized-kept", "folder": {"game": "ets2", "layout": "game", "dll": "foreign"}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "present", "dataRoot": null}},
    {"id": "read-only-kept", "folder": {"game": "ets2", "layout": "game", "dll": "owned", "readOnly": true}, "running": [],
      "expect": {"outcome": "deferred", "code": "READ_ONLY_FILE", "dll": "present", "dataRoot": ["plugins", "uninstall"]}},
    {"id": "linked-plugins-kept", "folder": {"game": "ets2", "layout": "plugins-link", "dll": "owned"}, "running": [],
      "expect": {"outcome": "deferred", "code": "LINKED_FOLDER", "dll": "present", "dataRoot": ["plugins", "uninstall"]}},
    {"id": "game-running", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": ["eurotrucks2.exe"],
      "expect": {"outcome": "deferred", "code": "GAME_RUNNING", "dll": "present", "dataRoot": ["plugins", "uninstall"]}},
    {"id": "client-running", "folder": {"game": "ats", "layout": "game", "dll": "owned"}, "running": ["truckersmp-launcher.exe"],
      "expect": {"outcome": "deferred", "code": "CLIENT_RUNNING", "dll": "present", "dataRoot": ["plugins", "uninstall"]}},
    {"id": "other-game-running", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": ["amtrucks.exe"],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "temporary-file-removed", "folder": {"game": "ets2", "layout": "game", "dll": "owned", "temp": true}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "temp": "absent", "dataRoot": null}},
    {"id": "created-plugins-folder-removed", "folder": {"game": "ets2", "layout": "game", "dll": "owned", "created": true}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "pluginsDirectory": "absent", "dataRoot": null}},
    {"id": "created-plugins-folder-kept-with-other-files", "folder": {"game": "ets2", "layout": "game", "dll": "owned", "created": true, "unrelated": true}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "pluginsDirectory": "present", "unrelated": "present", "dataRoot": null}},
    {"id": "game-folder-gone", "folder": {"game": "ets2", "layout": "gone", "dll": "none"}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "game-executable-missing", "folder": {"game": "ets2", "layout": "no-executable", "dll": "owned"}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "updates-entry-removed", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [], "data": {"updatesEntry": true},
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}},
    {"id": "unknown-data-entry-kept", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [], "data": {"unknownEntry": true},
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": ["notes"]}},
    {"id": "read-only-data-entry-kept", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [], "data": {"readOnlyEntry": true},
      "expect": {"outcome": "deferred", "code": "DATA_ENTRY_BLOCKED", "dll": "absent", "dataRoot": ["logs", "plugins", "uninstall"]}},
    {"id": "junction-in-data-not-followed", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [], "data": {"logsJunction": true},
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "sentinel": "present", "dataRoot": null}},
    {"id": "other-channel-plugin-kept", "folder": {"game": "ets2", "layout": "game", "dll": "owned", "otherChannel": true}, "running": [],
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "otherChannelDll": "present", "pluginsDirectory": "present", "dataRoot": null}},
    {"id": "allowlisted-entry-at-the-last-step", "folder": {"game": "ets2", "layout": "game", "dll": "owned"}, "running": [], "data": {"lateEntry": "logs"},
      "expect": {"outcome": "complete", "code": null, "dll": "absent", "dataRoot": null}}
  ]
}
